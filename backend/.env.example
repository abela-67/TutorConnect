# Copy to .env and fill in. Never commit the real .env file.
# (Reconstructed from the variables read by config/settings.py.)

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Addis_Ababa
# Set to 1 in production behind HTTPS
DJANGO_SECURE_SSL=0

# Leave DB_NAME empty for SQLite in local development; set it to use PostgreSQL.
DB_NAME=tutorconnect
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public photos only
MEDIA_ROOT=
# Private credentials: must NOT be served by the web server
PRIVATE_MEDIA_ROOT=
MAX_DOCUMENT_SIZE_MB=5
MAX_PHOTO_SIZE_MB=2

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Optional email; in-app notifications work without it
EMAIL_NOTIFICATIONS_ENABLED=0
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL=TutorConnect <no-reply@example.com>
LOG_LEVEL=INFO
